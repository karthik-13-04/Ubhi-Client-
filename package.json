{
  "name": "ubhi-next",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev --webpack",
    "dev:backend": "node backend/start-dev.js",
    "build": "npm run clean && next build --webpack",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "next start",
    "start:backend": "node backend/server.js",
    "seed": "node backend/db/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "gsap": "^3.15.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "next": "^16.2.9",
    "nodemailer": "^6.9.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^16.8.0"
  }
}
