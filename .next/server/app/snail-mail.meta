{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/snail-mail/layout,_N_T_/snail-mail/page,_N_T_/snail-mail"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/snail-mail/__PAGE__",
    "/snail-mail",
    "/_index",
    "/_head"
  ]
}